{
  "name": "miitjee-classes",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "web:dev": "vite",
    "web:build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "web:preview": "vite preview",
    "deploy": "npx vercel build --prod --yes && npx vercel deploy --prebuilt --prod --yes",
    "lint": "tsc --noEmit",
    "test": "jest",
    "android:setup": "node scripts/fix-document-picker-android.js && node scripts/fix-splash-screen-android.js && node scripts/fix-worklets-android.js && node scripts/fix-reanimated-android.js",
    "android": "npm run android:setup && node scripts/run-android.js",
    "android:build": "npm run android:setup && node scripts/build-android.js",
    "android:apk": "npm run android:setup && node scripts/build-android.js apk",
    "android:bundle": "npm run android:setup && node scripts/build-android.js release",
    "start": "node scripts/start-metro.js",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm run web:build && npm --prefix desktop start",
    "desktop:build": "npm run web:build && npm --prefix desktop run build:win"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@types/jszip": "^3.4.0",
    "axios": "^1.13.2",
    "jszip": "^3.10.2",
    "lucide-react-native": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.8",
    "react-native": "0.84.0",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.18.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-svg": "^15.15.0",
    "react-native-worklets": "0.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/runtime": "^7.28.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jest": "^29.7.0",
    "lucide-react": "^1.28.0",
    "react-dom": "^19.2.8",
    "react-native-web": "^0.21.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "vite": "^8.2.0"
  },
  "overrides": {
    "hermes-compiler": "250829098.0.10"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
